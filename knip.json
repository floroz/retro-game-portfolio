{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/main.tsx", "scripts/assets/*.ts"],
  "project": ["src/**/*.{ts,tsx}", "scripts/assets/**/*.ts"],
  "ignore": ["src/vite-env.d.ts"],
  "playwright": {
    "entry": ["test/**/*.test.ts"],
    "config": ["playwright.config.ts"]
  },
  "ignoreDependencies": ["midi-writer-js"]
}
