i #2c1a3c zurich
j #3a2c48 zurich
k #5c4670 zurich
l #0c1230 zurich
m #1c2c62 zurich
n #5876b0 zurich
o #b8c8e8 zurich
p #f2f4ff zurich
q #f8d880 zurich

# Sorrento: late afternoon into sunset. Terracotta, lemon
# yellows, majolica blue, Mediterranean sea and sky, sunset coral.
r #7c3220 sorrento
s #c45e36 sorrento
t #eea46c sorrento
u #f2c828 sorrento
v #fff1a0 sorrento
w #1c3a8c sorrento
x #2c7cc4 sorrento
y #7ccaea sorrento
