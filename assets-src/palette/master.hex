# Master palette for the v2 scenes.
# One "idx hex group" per line. "." is transparent and #ff00ff is the chroma key.
# Append-only after v1: never renumber or recolour an index. v2 appends 24
# colours with punctuation indices (never ".", "#", space, quotes, backslash,
# backtick, "|" or "$") for the Phase R remaster at 2x density.
# palette: v2

# Core: shared by everything, including the character. Seeded from v1 art.
# Neutral
0 #0f0d12 core
1 #2a2328 core
2 #4a4046 core
3 #7a6e6c core
4 #b0a49a core
5 #e8dcc8 core
# Wood
6 #3a2220 core
7 #49322d core
8 #6d3f31 core
9 #90583d core
A #a1603f core
# Skin
B #5c3b33 core
C #9a7860 core
D #bf987d core
E #e7bd98 core
# Navy
F #161c2f core
G #21283c core
H #2f3f66 core
I #466394 core
# Brass
J #8a6420 core
K #e0b040 core
# Red
L #5a1e1e core
M #9b3d34 core
N #c8483a core
# Green
O #4f7a3a core
P #7fae52 core

