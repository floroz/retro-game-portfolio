# --- v2 additions (Phase R: Remaster) ------------------------------------------
# Intermediate steps so each material gets 3-6 shades at 2x density, derived
# from where the shipped scenes and the approved raws band at 640x320.

# Core: neutral midtones (2-3 and 3-4; % is cool enough for steel and CRTs)
! #685353 core
% #8e888f core
# Core: wood, the darkest shadow (0-6) and a lit highlight above A
& #261412 core
( #bd7e57 core
# Core: warm skin midtone (D-E); also the travel map's parchment
) #d79e78 core
# Core: navy, the sweater's lit step (G-H) and the denim midtone (H-I)
* #283253 core
+ #304c7e core
# Core: dark leaf green for plants, shutters and shadows (below O)
, #274c2f core
# Core: brass midtone (J-K), for lamplight, rails and taps
- #ba8623 core

# Hall: the carpet's teal base and highlight (V is its shadow), kept at least
# 0.15 OKLab L above the jeans (I) so the character never sinks into the
# floor; a light mauve for the carpet's triangles; a mid daylight sky (X-Y).
/ #49a19c hall
: #7abeb8 hall
; #a16d8f hall
< #91c5ea hall

# London: red wall midtone (L-M), slate window blue (a-b), lamplit mahogany (8-9)
= #7f2925 london
> #4a617b london
? #83472f london

# Zurich: night sky (l-m), two lamplit plum steps above k, moonlit ice (n-o)
@ #141e45 zurich
[ #77618b zurich
] #927ca1 zurich
^ #879fcb zurich

# Sorrento: majolica periwinkle base and sunlit step (a floor well above the
# jeans), terracotta midtone (s-t), enamel cream (E-5) for the fridge and stove
_ #7a83b1 sorrento
{ #99a2cb sorrento
} #d37438 sorrento
~ #cab89b sorrento
